            <div class="model-info"><div class="mk">ホンダ</div><div class="mn">CBR250RR</div><div class="mp">〜58万円</div></div>
          </div>
          <div class="model-card">
            <div class="model-photo placeholder-img"><svg class="icon"><use href="#ic-photo"/></svg></div>
            <div class="model-info"><div class="mk">ホンダ</div><div class="mn">レブル250</div><div class="mp">〜50万円</div></div>
          </div>
          <div class="model-card">
            <div class="model-photo placeholder-img"><svg class="icon"><use href="#ic-photo"/></svg></div>
            <div class="model-info"><div class="mk">カワサキ</div><div class="mn">Ninja400</div><div class="mp">〜45万円</div></div>
          </div>
          <div class="model-card">
