<!-- ============================================================ -->
<!-- 1. 無料おためし査定フォーム ビュー -->
<!-- ============================================================ -->
<div id="view-form" class="hidden">

  <div class="form-header">
    <div class="form-header-row">
      <div class="form-title">無料おためし査定</div>
      <button class="close-x" onclick="requestExit('close-x')"><svg class="icon" style="width:14px;height:14px;"><use href="#ic-close"/></svg></button>
    </div>
  </div>
  <div class="progress-track"><div class="progress-fill" id="progress-fill"></div></div>
  <div class="progress-label" id="progress-label">STEP 1 / 3　バイク情報の入力</div>

  <div class="form-body">

    <!-- STEP1: 情報入力 -->
    <div class="form-step active" id="step-1">
      <h2>バイクの情報を教えてください</h2>
      <p class="step-desc">分かる範囲でOKです。不明な項目は「わからない」を選んでください。</p>

      <div class="field">
        <label>メーカー<span class="required">必須</span></label>
        <select id="f-maker">
          <option value="">選択してください</option>
          <option value="honda">ホンダ</option>
          <option value="yamaha">ヤマハ</option>
          <option value="suzuki">スズキ</option>
          <option value="kawasaki">カワサキ</option>
          <option value="other">その他・輸入車</option>
          <option value="unknown">わからない</option>
        </select>
      </div>

      <div class="field">
        <label>車種名（分かれば）</label>
        <input type="text" id="f-model" placeholder="例：CB400SF">
      </div>

      <div class="field">
        <label>排気量</label>
        <select id="f-displacement">
          <option value="">選択してください</option>
          <option value="〜125cc">〜125cc</option>
          <option value="126〜250cc">126〜250cc</option>
          <option value="251〜400cc">251〜400cc</option>
          <option value="401cc〜">401cc〜</option>
          <option value="わからない">わからない</option>
        </select>
      </div>

      <div class="field">
        <label>年式</label>
        <select id="f-year">
          <option value="">選択してください</option>
          <option>〜2000年</option>
          <option>2001〜2010年</option>
          <option>2011〜2020年</option>
          <option>2021年〜</option>
          <option>わからない</option>
        </select>
      </div>

      <div class="field">
        <label>走行距離</label>
        <select id="f-mileage">
          <option value="">選択してください</option>
          <option>〜5,000km</option>
          <option>5,000〜20,000km</option>
          <option>20,000〜50,000km</option>
          <option>50,000km以上</option>
          <option>わからない</option>
        </select>
      </div>

      <div class="field">
        <label>バイクの状態（複数選択可）</label>
        <div class="check-options" id="condition-options">
          <label><input type="checkbox" value="壊れている（事故・故障）" onchange="toggleOptionStyle(this)">壊れている（事故・故障）</label>
          <label><input type="checkbox" value="動かない（不動車）" onchange="toggleOptionStyle(this)">動かない（不動車）</label>
          <label><input type="checkbox" value="長期間保管（倉庫・車庫）" onchange="toggleOptionStyle(this)">長期保管（倉庫・車庫）</label>
          <label><input type="checkbox" value="車検切れ" onchange="toggleOptionStyle(this)">車検切れ</label>
          <label><input type="checkbox" value="書類なし" onchange="toggleOptionStyle(this)">書類なし</label>
          <label><input type="checkbox" value="特に問題なし" onchange="toggleOptionStyle(this)">特に問題なし</label>
        </div>
      </div>

      <div class="field">
        <label>お住まいの都道府県（出張エリア確認用）</label>
        <select id="f-pref">
          <option value="">選択してください</option>
          <option>北海道・東北</option>
          <option>関東</option>
          <option>中部・北陸</option>
          <option>関西</option>
          <option>中国・四国</option>
          <option>九州・沖縄</option>
        </select>
      </div>
    </div>

    <!-- STEP2: バイク一覧表示（参考価格） -->
    <div class="form-step" id="step-2">
      <h2>参考買取価格の目安です</h2>
      <p class="step-desc">入力内容に近いバイクの参考価格帯です。実際の金額は出張査定でご提示します。</p>

      <div id="bike-match-list"></div>

      <div class="disclaimer-box">
        ※価格はダミーデータによる表示イメージです。実際の相場データに差し替えて運用してください。
      </div>
    </div>

    <!-- STEP3: 連絡先入力 -->
    <div class="form-step" id="step-3">
      <h2>ご連絡先を入力してください</h2>
      <p class="step-desc">査定結果・日程調整のご連絡に使用します。</p>

      <div class="field">
        <label>お名前<span class="required">必須</span></label>
        <input type="text" id="f-name" placeholder="例：山田 太郎">
      </div>
      <div class="field">
        <label>電話番号<span class="required">必須</span></label>
        <input type="tel" id="f-tel" placeholder="例：090-1234-5678">
      </div>
      <div class="field">
        <label>メールアドレス<span class="required">必須</span></label>
        <input type="email" id="f-email" placeholder="例：sample@example.com">
      </div>
      <div class="field">
        <label>ご希望の連絡方法</label>
        <div class="radio-rows">
          <label><input type="radio" name="contact-method" value="電話" checked>電話</label>
          <label><input type="radio" name="contact-method" value="メール">メール</label>
          <label><input type="radio" name="contact-method" value="LINE">LINE</label>
        </div>
      </div>
      <div class="field">
        <label>ご希望の査定日時</label>
        <select id="f-datetime">
          <option value="">選択してください</option>
          <option>平日 午前</option>
          <option>平日 午後</option>
          <option>土日 午前</option>
          <option>土日 午後</option>
          <option>いつでも可</option>
        </select>
      </div>
      <div class="field">
        <label>備考（任意）</label>
        <textarea id="f-note" placeholder="鍵が見つからない、車検証がない、などご自由にご記入ください"></textarea>
      </div>

      <div class="confirm-box" id="confirm-summary"></div>

      <label class="agree-row">
        <input type="checkbox" id="f-agree">
        <span><a href="#" onclick="return false;">プライバシーポリシー（ダミー）</a>に同意の上、送信します。</span>
      </label>
    </div>

  </div>

  <div class="form-nav">
    <div class="form-nav-inner">
      <button class="btn btn-outline hidden" id="btn-back" onclick="prevStep()">戻る</button>
      <button class="btn btn-primary" id="btn-next" onclick="nextStep()">バイクの参考価格を見る →</button>
    </div>
  </div>
</div>


<!-- ============================================================ -->
<!-- 2. サンクスビュー -->
<!-- ============================================================ -->
<div id="view-thanks" class="hidden">
  <div class="thanks-wrap">
    <div class="thanks-icon"><svg class="icon" style="stroke:#fff;"><use href="#ic-check"/></svg></div>
    <h2>お申し込みありがとうございます！</h2>
    <p>担当者より1営業日以内にご連絡いたします。<br>お急ぎの方はお電話またはLINEでもご相談いただけます。<br><br>
    <span class="note">（本ページはモックアップのため、実際の送信・メール転送・LINE連携は行われていません）</span></p>
    <div class="thanks-cta">
      <button class="btn btn-primary" onclick="window.location.href='tel:0000000000'">
        <svg class="icon"><use href="#ic-phone"/></svg> 電話をかける（ダミー）
      </button>
      <button class="btn btn-line" onclick="openLineDummy('thanks')">
        <svg class="icon"><use href="#ic-chat"/></svg> LINEで相談する
      </button>
      <button class="btn btn-outline" onclick="backToLp()">トップページに戻る</button>
    </div>
  </div>
</div>


<!-- ============================================================ -->
<!-- 離脱防止：LINE査定案内モーダル -->
<!-- ============================================================ -->
<div id="exit-modal-overlay" class="hidden">
  <div class="exit-modal">
    <button class="exit-modal-close" onclick="closeExitModal()"><svg class="icon" style="width:13px;height:13px;"><use href="#ic-close"/></svg></button>
    <div class="exit-modal-banner">
      <span class="exit-modal-badge">査定でのやり取り不要！<br>LINEで完結</span>
      <div class="exit-modal-copy">
        <p class="lead">バイクのお試し査定を</p>
        <p class="headline">もっと簡単に。</p>
        <p class="sub">簡単3ステップでLINEから<br>買取上限金額がわかる</p>
      </div>
      <div class="exit-modal-phone">
        <svg class="icon" style="width:26px;height:26px;color:var(--line-green);"><use href="#ic-chat"/></svg>
      </div>
      <div class="exit-modal-thumbrow">
        <div class="placeholder-img"><svg class="icon" style="width:12px;height:12px;"><use href="#ic-photo"/></svg></div>
        <div class="placeholder-img"><svg class="icon" style="width:12px;height:12px;"><use href="#ic-photo"/></svg></div>
        <div class="placeholder-img"><svg class="icon" style="width:12px;height:12px;"><use href="#ic-photo"/></svg></div>
      </div>
    </div>
    <div class="exit-modal-body">
      <button class="btn btn-line" onclick="openLineDummy('exit-modal')">LINE査定</button>
      <a class="exit-modal-detail" onclick="openLineDetailDummy()">＞ 詳細はこちら</a>
    </div>
  </div>
</div>


<script>
/* =========================================================
   ダミーデータ：バイクの参考買取価格（メーカー別）
   本番運用時は実際の相場データ/APIに差し替えてください
========================================================= */
const BIKE_PRICE_DATA = {
  honda:   [{name:"ホンダ CB400SF", low:8, high:25},{name:"ホンダ PCX", low:5, high:18},{name:"ホンダ モンキー125", low:10, high:22}],
  yamaha:  [{name:"ヤマハ セロー250", low:6, high:20},{name:"ヤマハ MT-07", low:15, high:40},{name:"ヤマハ トリシティ", low:4, high:15}],
  suzuki:  [{name:"スズキ GSX-R", low:12, high:35},{name:"スズキ アドレス110", low:2, high:8},{name:"スズキ バンディット", low:7, high:22}],
  kawasaki:[{name:"カワサキ Ninja250", low:10, high:28},{name:"カワサキ Z900", low:20, high:55},{name:"カワサキ エストレヤ", low:6, high:18}],
  other:   [{name:"輸入車・その他モデルA", low:5, high:30},{name:"輸入車・その他モデルB", low:3, high:20}],
  unknown: [{name:"国産バイク（一般的な相場例）", low:3, high:25}]
};

function el(id){ return document.getElementById(id); }

/* ---------- ヒーロー埋め込みミニ査定（3項目を最初から表示） ---------- */
const heroMakerSelect = el('hero-maker');
const heroDisplacementSelect = el('hero-displacement');
const heroModelInput = el('hero-model');
const heroNextBtn = el('hero-quiz-next');
heroMakerSelect.addEventListener('change', () => {
  heroNextBtn.disabled = !heroMakerSelect.value;
});
function heroStartAssessment(){
  if(!heroMakerSelect.value) return;
  el('f-maker').value = heroMakerSelect.value;
  if(heroDisplacementSelect.value){ el('f-displacement').value = heroDisplacementSelect.value; }
  if(heroModelInput.value){ el('f-model').value = heroModelInput.value; }
  openForm();
}

/* ---------- ビュー切り替え ---------- */
function openForm(){
  el('view-lp').classList.add('hidden');
  el('view-thanks').classList.add('hidden');
  el('view-form').classList.remove('hidden');
  window.scrollTo(0,0);
  goToStep(1);
  armExitGuard();
}
function backToLp(){
  el('view-form').classList.add('hidden');
  el('view-thanks').classList.add('hidden');
  el('view-lp').classList.remove('hidden');
  window.scrollTo(0,0);
  disarmExitGuard();
}
function goThanks(){
  el('view-form').classList.add('hidden');
  el('view-thanks').classList.remove('hidden');
  window.scrollTo(0,0);
  disarmExitGuard();
}

/* ---------- LINE（ダミー）誘導 ---------- */
function openLineDummy(source){
  alert('【モックアップ】LINE公式アカウントの友だち追加画面へ遷移します。\n（遷移元: ' + source + '）\n\n本番実装では実際のLINE公式アカウントの追加URL（https://lin.ee/xxxxxxx など）に置き換えてください。');
}
function openLineDetailDummy(){
  alert('【モックアップ】LINE査定の詳細説明ページへ遷移します。\n（遷移元: exit-modal 詳細リンク）\n\n本番実装ではLINE査定の流れを説明するページ／セクションへのリンクに置き換えてください。');
}

/* ---------- FAQ ---------- */
function toggleFaq(btn){
  const item = btn.closest('.faq-item');
  item.classList.toggle('open');
}

/* ---------- チェックボックス見た目 ---------- */
function toggleOptionStyle(input){
  input.closest('label').classList.toggle('on', input.checked);
}

/* =========================================================
   査定フォーム：ステップ制御
========================================================= */
let currentStep = 1;
const totalSteps = 3;
const stepLabels = ['バイク情報の入力', '参考価格の確認', 'ご連絡先の入力'];

function goToStep(n){
  currentStep = n;
  document.querySelectorAll('.form-step').forEach(s => s.classList.remove('active'));
  el('step-' + n).classList.add('active');
  el('progress-fill').style.width = Math.round((n/totalSteps)*100) + '%';
  el('progress-label').textContent = 'STEP ' + n + ' / ' + totalSteps + '　' + stepLabels[n-1];
  el('btn-back').classList.toggle('hidden', n === 1);

  if(n === 1){ el('btn-next').textContent = 'バイクの参考価格を見る →'; }
  if(n === 2){ el('btn-next').textContent = 'この内容で無料査定を申し込む →'; renderBikeMatches(); }
  if(n === 3){ el('btn-next').textContent = '送信する'; renderConfirmSummary(); }

  window.scrollTo(0,0);
}

function nextStep(){
  if(currentStep === 1){
    if(!el('f-maker').value){
      alert('メーカーを選択してください。');
      return;
    }
  }
  if(currentStep === 3){
    if(!el('f-name').value || !el('f-tel').value || !el('f-email').value){
      alert('お名前・電話番号・メールアドレスをご入力ください。');
      return;
    }
    if(!el('f-agree').checked){
      alert('プライバシーポリシーへの同意にチェックをお願いします。');
      return;
    }
    submitForm();
    return;
  }
  if(currentStep < totalSteps){
    goToStep(currentStep + 1);
  }
}
function prevStep(){
  if(currentStep > 1){ goToStep(currentStep - 1); }
}

function renderBikeMatches(){
  const maker = el('f-maker').value || 'unknown';
  const list = BIKE_PRICE_DATA[maker] || BIKE_PRICE_DATA.unknown;
  const conditions = Array.from(document.querySelectorAll('#condition-options input:checked')).map(i => i.value);
  const isImmobile = conditions.some(c => c.includes('動かない') || c.includes('壊れている'));

  let html = '';
  list.forEach(b => {
    html += `
      <div class="bike-match-card">
        <div class="bike-match-img placeholder-img"><svg class="icon"><use href="#ic-photo"/></svg>画像準備中</div>
        <div class="bike-match-info">
          <h4>${b.name}</h4>
          <div class="bike-match-price">${b.low}万円 〜 ${b.high}万円（目安）</div>
          <div class="bike-match-tags">
            ${isImmobile ? '<span>不動車OK</span>' : ''}
            <span>出張査定￥0</span>
          </div>
        </div>
      </div>`;
  });
  el('bike-match-list').innerHTML = html;
}

function renderConfirmSummary(){
  const maker = el('f-maker').selectedOptions[0]?.text || '未選択';
  const model = el('f-model').value || '未入力';
  const displacement = el('f-displacement').value || '未選択';
  const conditions = Array.from(document.querySelectorAll('#condition-options input:checked')).map(i => i.value).join('、') || 'なし';
  el('confirm-summary').innerHTML = `
    <div class="confirm-row"><span class="k">メーカー</span><span>${maker}</span></div>
    <div class="confirm-row"><span class="k">車種</span><span>${model}</span></div>
    <div class="confirm-row"><span class="k">排気量</span><span>${displacement}</span></div>
    <div class="confirm-row"><span class="k">状態</span><span>${conditions}</span></div>
  `;
}

function submitForm(){
  /*
    TODO(バックエンド連携):
    ここで査定申し込み内容をサーバーAPIへPOSTし、
    1) 査定担当者宛への申し込み内容メール転送
    2) お客様宛の自動返信メール送信
    3) 必要であればLINE公式アカウントとの顧客連携
    を行う処理を実装してください（本モックアップでは未実装）。
  */
  el('btn-next').textContent = '送信中...';
  setTimeout(() => {
    goThanks();
  }, 500);
}

/* =========================================================
   離脱防止：入力中に離脱しようとしたらLINE査定モーダルを強制表示
   - 上方向へのマウス移動（PC：exit intent）
   - 閉じる(×)ボタン
   - ブラウザの戻る操作（popstate）
========================================================= */
let exitGuardArmed = false;
let exitIntentShown = false;

function armExitGuard(){
  exitGuardArmed = true;
  exitIntentShown = false;
  history.pushState({txtGarageForm:true}, '');
  document.addEventListener('mouseout', onMouseOutExitIntent);
  window.addEventListener('popstate', onPopStateExitIntent);
}
function disarmExitGuard(){
  exitGuardArmed = false;
  document.removeEventListener('mouseout', onMouseOutExitIntent);
  window.removeEventListener('popstate', onPopStateExitIntent);
}
function onMouseOutExitIntent(e){
  if(!exitGuardArmed || exitIntentShown) return;
  if(e.clientY <= 0){
    showExitModal();
  }
}
function onPopStateExitIntent(){
  if(!exitGuardArmed) return;
  showExitModal();
  // ユーザーがまだフォーム上にいる想定で履歴を積み戻す
  history.pushState({txtGarageForm:true}, '');
}
function requestExit(source){
  showExitModal();
}
function showExitModal(){
  exitIntentShown = true;
  el('exit-modal-overlay').classList.remove('hidden');
}
function closeExitModal(){
  el('exit-modal-overlay').classList.add('hidden');
}
</script>

</body>
</html>
